{
  "name": "creatoros-desktop",
  "private": true,
  "version": "1.0.0",
  "main": "electron.cjs",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"tsx server.ts\" \"tsx local-worker.ts\" \"python py_ws_bridge.py --port 8765\"",
    "dev:all": "concurrently \"tsx server.ts\" \"npm run worker\"",
    "worker": "tsx local-worker.ts",
    "build:frontend": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:python": "pyinstaller --clean build.spec --distpath dist_py",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist release dist_py build",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\"",
    "electron:build": "npm run build && electron-builder --win -c electron-builder.yml",
    "dist:win": "npm run build && electron-builder --win -c electron-builder.yml",
    "build:all": "npm run build && npm run build:python && electron-builder --win -c electron-builder.yml"
  },
  "build": {
    "appId": "com.creatoros.desktop",
    "productName": "CreatorOS Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "archiver": "^8.0.0",
    "bullmq": "^6.3.1",
    "canvas-confetti": "^1.9.4",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^13.1.1",
    "http-errors": "^2.0.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "python-shell": "^5.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^5.1.7",
    "systeminformation": "^5.33.5",
    "vite": "^6.2.3",
    "ws": "^8.21.3",
    "youtube-dl-exec": "^3.1.13"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.14.0",
    "@types/python-shell": "^1.0.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
